{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "outputs": ["dist/relater", "dist/build.json", "dist/cli.ll"]
    },
    "build:oracle": {
      "outputs": ["dist/*-oracle", "dist/tsgo", "dist/oracle-build.json"],
      "inputs": ["oracle/**", "oracles/**", "checkhost/**", "scripts/build-oracle.mjs", "$TURBO_ROOT$/upstream.json"]
    },
    "translate": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "build:check": {
      "outputs": ["dist/check"]
    },
    "test": {
      "dependsOn": ["build", "build:oracle"],
      "cache": false
    },
    "test:corpus": {
      "dependsOn": ["build:oracle"],
      "cache": false
    },
    "@tsc-ts/gots#build": {
      "outputs": []
    },
    "tsc-ts#build": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/tsgo/src/**"]
    }
  }
}

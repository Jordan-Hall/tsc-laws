(
(assume a0 (or (not (= (and a b) (and b a))) (not true)))
(step t0 (cl (not (= (or (not (= (and a b) (and b a))) (not true)) (not (= (and a b) (and b a))))) (not (or (not (= (and a b) (and b a))) (not true))) (not (= (and a b) (and b a)))) :rule equiv_pos2)
(step t1 (cl (= (not true) false)) :rule evaluate)

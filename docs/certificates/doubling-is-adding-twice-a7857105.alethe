(
(assume a0 (or (not (= (* a 2) (+ a a))) (not true)))
(step t0 (cl (not (= (or (not (= (* a 2) (+ a a))) (not true)) false)) (not (or (not (= (* a 2) (+ a a))) (not true))) false) :rule equiv_pos2)
(step t1 (cl (= (* a 2) (* 2 a))) :rule poly_simp)
(step t2 (cl (= (+ a a) (* 2 a))) :rule poly_simp)
(step t3 (cl (= (= (* a 2) (+ a a)) (= (* 2 a) (* 2 a)))) :rule cong :premises (t1 t2))
(step t4 (cl (= (= (* 2 a) (* 2 a)) true)) :rule rare_rewrite :args ("eq-refl" (* 2 a)))
(step t5 (cl (= (= (* a 2) (+ a a)) true)) :rule trans :premises (t3 t4))
(step t6 (cl (= (not (= (* a 2) (+ a a))) (not true))) :rule cong :premises (t5))
(step t7 (cl (= (not true) false)) :rule evaluate)
(step t8 (cl (= (not (= (* a 2) (+ a a))) false)) :rule trans :premises (t6 t7))
(step t9 (cl (= (or (not (= (* a 2) (+ a a))) (not true)) (or false false))) :rule cong :premises (t8 t7))
(step t10 (cl (= (or false false) false)) :rule evaluate)
(step t11 (cl (= (or (not (= (* a 2) (+ a a))) (not true)) false)) :rule trans :premises (t9 t10))
(step t12 (cl false) :rule resolution :premises (t0 t11 a0))
(step t13 (cl (not false)) :rule false)
(step t14 (cl) :rule resolution :premises (t12 t13))
)

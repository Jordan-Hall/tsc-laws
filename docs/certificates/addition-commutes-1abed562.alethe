(
(assume a0 (or (not (= (+ a b) (+ b a))) (not true)))
(step t0 (cl (not (= (or (not (= (+ a b) (+ b a))) (not true)) false)) (not (or (not (= (+ a b) (+ b a))) (not true))) false) :rule equiv_pos2)
(step t1 (cl (= (+ b a) (+ a b))) :rule poly_simp)
(step t2 (cl (= (= (+ a b) (+ b a)) (= (+ a b) (+ a b)))) :rule cong :premises (t1))
(step t3 (cl (= (= (+ a b) (+ a b)) true)) :rule rare_rewrite :args ("eq-refl" (+ a b)))
(step t4 (cl (= (= (+ a b) (+ b a)) true)) :rule trans :premises (t2 t3))
(step t5 (cl (= (not (= (+ a b) (+ b a))) (not true))) :rule cong :premises (t4))
(step t6 (cl (= (not true) false)) :rule evaluate)
(step t7 (cl (= (not (= (+ a b) (+ b a))) false)) :rule trans :premises (t5 t6))
(step t8 (cl (= (or (not (= (+ a b) (+ b a))) (not true)) (or false false))) :rule cong :premises (t7 t6))
(step t9 (cl (= (or false false) false)) :rule evaluate)
(step t10 (cl (= (or (not (= (+ a b) (+ b a))) (not true)) false)) :rule trans :premises (t8 t9))
(step t11 (cl false) :rule resolution :premises (t0 t10 a0))
(step t12 (cl (not false)) :rule false)
(step t13 (cl) :rule resolution :premises (t11 t12))
)

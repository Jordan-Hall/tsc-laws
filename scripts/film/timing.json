  "text": {
    "law": [
      "export law proved clampWithinBounds(",
      "  x: number, lo: number, hi: number,",
      ") {",
      "  assume(lo <= hi);",
      "  const y = clamp(x, lo, hi);",
      "  return y >= lo && y <= hi;",
      "}"
    ],
    "lawEdited": "assume(lo < hi);",

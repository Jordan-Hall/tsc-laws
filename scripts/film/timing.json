{
  "voice": {
    "voice": "af_heart",
    "speed": 0.93,
    "lines": [
      {
        "id": "meet",
        "frame": 40,
        "sentences": [
          {
            "text": "This is Tally.",
            "gapMs": 450
          },
          {
            "text": "Tally keeps the rules."
          }
        ]
      },
      {
        "id": "law",
        "frame": 284,
        "sentences": [
          {
            "text": "You write a rule your code has to keep.",
            "gapMs": 420
          },
          {
            "text": "That's a law."
          }
        ]
      },
      {
        "id": "work",
        "frame": 526,
        "sentences": [
          {
            "text": "Then tslaws goes to work.",
            "say": "Then T S laws goes to work.",
            "gapMs": 400
          },
          {
            "text": "It doesn't only test the law.",
            "gapMs": 380
          },
          {
            "text": "It proves it."
          }
        ]
      },
      {
        "id": "proved",
        "frame": 926,
        "sentences": [
          {
            "text": "Proved, for every input."
          }
        ]
      },
      {
        "id": "broken",
        "frame": 1046,
        "sentences": [
          {
            "text": "Or it finds the one input that breaks it."
          }
        ]
      },
      {
        "id": "cert",
        "frame": 1366,
        "sentences": [
          {
            "text": "Every proof can carry a certificate.",
            "gapMs": 420
          },
          {
            "text": "cvc5 writes it out.",
            "say": "C V C five writes it out.",
            "gapMs": 420
          },
          {
            "text": "A second program, Carcara, checks each step."
          }
        ]
      },
      {
        "id": "loops",
        "frame": 1926,
        "sentences": [
          {
            "text": "Even loops get one, through their invariants."
          }
        ]
      },
      {
        "id": "lock",
        "frame": 2166,
        "sentences": [
          {
            "text": "The lock remembers every law.",
            "gapMs": 420
          },
          {
            "text": "Change one, and it knows."
          }
        ]
      },
      {
        "id": "gate",
        "frame": 2566,
        "sentences": [
          {
            "text": "A new law can't accept itself.",
            "gapMs": 420
          },
          {
            "text": "Tally can propose it.",
            "gapMs": 380
          },
          {
            "text": "But a person has to promote it."
          }
        ]
      },
      {
        "id": "sandbox",
        "frame": 3166,
        "sentences": [
          {
            "text": "And every law runs in a sandbox.",
            "gapMs": 420
          },
          {
            "text": "It can't write files, or start a process."
          }
        ]
      },
      {
        "id": "close",
        "frame": 3606,
        "sentences": [
          {
            "text": "Write a law.",
            "gapMs": 520
          },
          {
            "text": "Let it be proved."
          }
        ]
      },
      {
        "id": "end",
        "frame": 4126,
        "sentences": [
          {
            "text": "tslaws, one point oh.",
            "say": "T S laws. One point oh."
          }
        ]
      }

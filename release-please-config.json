{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "tag-separator": "-",
  "pull-request-title-pattern": "chore(release): tslaws ${version}",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "tslaws",
      "component": "laws",
      "changelog-path": "CHANGELOG-LAWS.md",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Fixes"
        },
        {
          "type": "perf",
          "section": "Performance"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "docs",
          "section": "Docs",
          "hidden": true
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "chore",
          "section": "Chores",
          "hidden": true
        },
        {
          "type": "ci",
          "section": "CI",
          "hidden": true
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": true
        },
        {
          "type": "style",
          "section": "Style",
          "hidden": true
        },
        {
          "type": "refactor",
          "section": "Refactors",
          "hidden": true
        }
      ],
      "extra-files": [
        {
          "type": "json",
          "path": "packages/tslaws/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/vscode-tslaws/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/tslaws'].version"
        },
        {
          "type": "json",
          "path": "package-lock.json",
          "jsonpath": "$.packages['packages/vscode-tslaws'].version"
        }
      ],
      "exclude-paths": ["apps", "docs", "examples"]
    }
  }
}

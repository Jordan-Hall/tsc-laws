{
  "name": "tsc-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --outDir dist --rootDir .. --target es2024 --module nodenext --moduleResolution nodenext --strict --skipLibCheck --types node src/main.ts",
    "build:native": "scriptc build src/main.ts -o dist/tsc",
    "generate": "node scripts/generate.mjs && node scripts/generate-diagnostics.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@tsc-ts/tsgo": "*"
  }
}

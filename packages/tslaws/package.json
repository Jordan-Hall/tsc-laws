{
  "name": "tslaws",
  "version": "1.2.0",
  "description": "Runs and checks `law` declarations compiled by tsc-laws: property tests, SMT proofs, tamper lock.",
  "bin": {
    "tslaws": "bin/tslaws.js"
  },
  "files": [
    "bin",
    "dist",
    "env.d.ts",
    "hooks",
    "ui"
  ],
  "type": "module",
  "main": "./dist/api.js",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js",
      "default": "./dist/api.js"
    },
    "./browser": {
      "types": "./dist/browserApi.d.ts",
      "import": "./dist/browserApi.js",
      "default": "./dist/browserApi.js"
    },
    "./e2e": {
      "types": "./dist/e2eApi.d.ts",
      "import": "./dist/e2eApi.js",
      "default": "./dist/e2eApi.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js",
      "default": "./dist/security/index.js"
    },
    "./adapters/react": {
      "types": "./dist/adapters/react.d.ts",
      "import": "./dist/adapters/react.js",
      "default": "./dist/adapters/react.js"
    },
    "./adapters/angular": {
      "types": "./dist/adapters/angular.d.ts",
      "import": "./dist/adapters/angular.js",
      "default": "./dist/adapters/angular.js"
    },
    "./adapters/dom": {
      "types": "./dist/adapters/dom.d.ts",
      "import": "./dist/adapters/dom.js",
      "default": "./dist/adapters/dom.js"
    },
    "./adapters/element": {
      "types": "./dist/adapters/element.d.ts",
      "import": "./dist/adapters/element.js",
      "default": "./dist/adapters/element.js"
    },
    "./env": {
      "types": "./env.d.ts"
    },
    "./internal/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=3 --import ./test/setup.ts test/*.test.ts",
    "check": "node bin/tslaws.js check",
    "laws": "node bin/tslaws.js check laws/core.laws.ts",
    "check:watch": "node bin/tslaws.js check --watch"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "fast-check": "^4.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "z3-solver": "^4.15.0"
  },
  "devDependencies": {
    "@tsrx/ripple": "0.2.11",
    "@types/node": "^24.0.0",
    "ripple": "0.6.1"
  },
  "peerDependencies": {
    "axe-core": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  }
}

{
  "name": "vscode-tslaws",
  "displayName": "tsc-laws syntax",
  "description": "Highlighting for law declarations of the tsc-laws TypeScript dialect",
  "version": "0.0.1",
  "private": true,
  "publisher": "tsc-laws",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.tslaws",
        "path": "./syntaxes/tslaws.injection.json",
        "injectTo": ["source.ts", "source.tsx"]
      }
    ]
  },
  "scripts": {
    "test": "node --test test/grammar.test.mjs"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}

{
  "name": "tsc-ts",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:oracle": "turbo run build:oracle",
    "fetch:upstream": "node scripts/fetch-upstream.mjs",
    "test": "turbo run test",
    "test:corpus": "turbo run test:corpus",
    "translate": "turbo run translate",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "scriptc": "0.2.6",
    "turbo": "2.11.7",
    "typescript": "5.9"
  },
  "packageManager": "npm@11.19.0"
}

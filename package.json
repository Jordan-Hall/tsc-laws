{
  "name": "tsc-ts",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev:web": "npm run dev -w @tsc-ts/web",
    "build:web": "npm run build -w @tsc-ts/web",
    "build:oracle": "turbo run build:oracle",
    "fetch:upstream": "node scripts/fetch-upstream.mjs",
    "test": "turbo run test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@scriptc/threads": "0.4.8",
    "@types/node": "^24.19.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "scriptc": "0.4.8",
    "turbo": "2.11.7",
    "typescript": "5.9"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "glob": "^14.0.2",
    "katex": "^0.18.2",
    "minimatch": "^11.0.1",
    "zod": "^4.6.6"
  },
  "packageManager": "npm@11.19.0"
}

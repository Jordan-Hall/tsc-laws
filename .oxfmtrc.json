{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 120,
  "ignorePatterns": [
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "packages/tsc-ts/tests/fixtures/**",
    "**/dist/**",
    "**/.next/**",
    "**/.source/**",
    "**/next-env.d.ts",
    "upstream/**",
    "**/*.laws.ts",
    "**/.tslaws/**",
    "**/.tmp-*/**"
  ]
}
